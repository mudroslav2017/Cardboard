--- !u!1 &1669403989
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 1669403990}
  - component: {fileID: 1669403993}
  - component: {fileID: 1669403992}
  - component: {fileID: 1669403991}
  m_Layer: 0
  m_Name: "\u0418\u0417 \u041F\u0410\u0421\u041F\u041E\u0420\u0422\u0410 \u041A\u0420-3\n\n\u041A\u0443\u043B\u0430\u0447\u043A\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u0430\n\u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C \u043F\u0430\u043A\u0435\u0442\u0435.\n\n\u041A\u043E\u0436\u0443\u0445 \u0441\u0446\u0435\u043F\u043B\u044F\u0435\u0442 \u043C\u0443\u0444\u0442\u0443.\n\u041F\u0440\u0443\u0436\u0438\u043D\u0430: \u0422\u0420\u0418 \u043E\u0431\u043E\u0440\u043E\u0442\u0430.\n\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 = \u0441\u0431\u0440\u043E\u0441 \u043D\u0430\u0442\u044F\u0433\u0430.\n\n\u041D\u0435 \u0440\u0432\u0430\u0442\u044C \u0440\u0435\u0437\u0430\u043A \u043D\u0430 \u0441\u0442\u043E\u043F\u043E\u0440\u0435.\n\u041F\u0430\u043A\u0435\u0442 \u043E\u0442\u0434\u0430\u0451\u0442 \u0431\u0435\u0437 \u043F\u0440\u0438\u0436\u0438\u043C\u0430.\n\u0427\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u043B\u0438\u0441\u0442 \u2014 \u043F\u0435\u0440\u0435\u043A\u043E\u0441."
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
