  m_Name: "\u041B\u041A\u041C: \u0414\u0415\u0420\u0416\u0410\u0422\u042C \u0418 \u0414\u0412\u0418\u0413\u0410\u0422\u042C \u0414\u0415\u0422\u0410\u041B\u042C\n\u0421\u0415\u041B\u0415\u041A\u0422\u041E\u0420\u042B / \u041C\u0410\u0425\u041E\u0412\u0418\u041A: \u0412\u0420\u0410\u0429\u0410\u0422\u042C \u041F\u041E \u041A\u0420\u0423\u0413\u0423\n\u0420\u042B\u0427\u0410\u0413\u0418 / \u041A\u041E\u0416\u0423\u0425: \u0412\u0412\u0415\u0420\u0425-\u0412\u041D\u0418\u0417. \u0420\u0415\u0417\u0410\u041A: \u0412\u041D\u0418\u0417\nE \u2014 \u0420\u042B\u0412\u041E\u041A / ESC \u2014 \u041E\u0422\u041F\u0423\u0421\u0422\u0418\u0422\u042C"
